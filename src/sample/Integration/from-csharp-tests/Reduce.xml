<WorkSheet>
    <Name>Reduce</Name>
    <Variables>
        <Variable><Key>InputRecord</Key><Value>{Amount:1}</Value></Variable>
        <Variable><Key>State</Key><Value>0</Value></Variable>
    </Variables>
    <Cells>
        <WorkCell>
            <Id>1</Id>
            <Name>Total</Name>
            <Formula>State + InputRecord.Amount</Formula>
            <Comments/>
        </WorkCell>
    </Cells>
</WorkSheet>
