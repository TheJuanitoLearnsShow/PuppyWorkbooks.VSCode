<?xml version="1.0" encoding="utf-8"?>
<Integration Name="Sales total" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="Integration.xsd">
    <Steps>
        <IOInput Id="input" Kind="CSVReader" FilePath="Input1.csv"/>
        <Map Id="map">
            <Worksheet FilePath="Map.xml"/>
        </Map>
        <Filter Id="filter">
            <Worksheet FilePath="Filter.xml"/>
        </Filter>
        <Reduce Id="reduce" OutputField="Total">
            <InitialStateJson>0</InitialStateJson>
            <Worksheet FilePath="Reduce.xml"/>
        </Reduce>
        <IOOutput Id="output" Kind="CSVWriter" FilePath="Output1.csv"/>
    </Steps>
</Integration>
