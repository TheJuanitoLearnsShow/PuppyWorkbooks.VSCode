{
  "name": "puppyworkbookseditor",
  "displayName": "Puppy Workbooks Editor",
  "description": "Allows editing integration workbooks and worksheet with PowerFX and XML",
  "publisher": "juanito",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": ["onLanguage:xml"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "powerfx",
        "aliases": ["PowerFx"]
      }
    ],
    "grammars": [
      {
        "language": "powerfx",
        "scopeName": "source.powerfx",
        "path": "./syntaxes/powerfx.tmLanguage.json"
      },
      {
        "scopeName": "text.xml.powerfx.injection",
        "path": "./syntaxes/xml.tmLanguage.json",
        "injectTo": [
          "text.xml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "fast-xml-parser": "^4.3.0"
  }
}
