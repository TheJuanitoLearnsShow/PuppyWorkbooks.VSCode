{
  "name": "Power Fx in XML Formula elements",
  "scopeName": "text.xml.powerfx.injection",
  "injectionSelector": "L:text.xml",
  "patterns": [
    {
      "begin": "(<)(Formula)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.localname.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      },
      "end": "(</)(Formula)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.localname.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      },
      "contentName": "source.powerfx",
      "patterns": [
        { "include": "source.powerfx" }
      ]
    }
  ]
}
