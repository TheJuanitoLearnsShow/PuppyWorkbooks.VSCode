{
  "scopeName": "source.powerfx",
  "name": "PowerFx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.powerfx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.powerfx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.powerfx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.powerfx",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.powerfx",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.powerfx",
          "match": "\\b(If|Switch|With|Let|As|ThisRecord|Self|Parent|true|false|Blank|Error|Collect|ClearCollect|Set|UpdateContext)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.powerfx",
          "match": "(\\+|\\-|\\*|\\/|\\^|&&|\\|\\||=|<>|<=|>=|<|>|!)"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "support.function.powerfx",
          "match": "\\b(Sum|Filter|LookUp|Patch|Collect|Clear|UpdateContext|Navigate|Rand|Text|Value|CountRows|CountIf|Sort|SortByColumns|AddColumns|DropColumns|RenameColumns|ShowColumns|Search|Concat|Split|Left|Right|Mid|Upper|Lower|Trim|Len|IsBlank|IsError|Coalesce|Sequence|Table|First|Last|Defaults)\\b(?=\\s*\\()"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.powerfx",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.property.powerfx",
          "match": "\\.[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.powerfx",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.begin.powerfx",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.powerfx",
          "match": "\\)"
        }
      ]
    }
  }
}
